; Simulation description
title   =   NPT simulation for specific configuration
; Environment setting
    ; System setting
    ; vdW setting
vdwtype =   cutoff 
cutoff-scheme   =   Verlet 
vdw-modifier    =   force-switch 
rvdw    =   1.2 
rvdw-switch =   1.0
    ; Coulomb setting
coulombtype =   PME 
pme-order   =   4 
rcoulomb    =   1.2
    ; Bond setting
constraints =   h-bonds 
constraint-algorithm    =   LINCS 
lincs-iter  =   1 
lincs-order =   4
    ; Neighbor list setting
rlist   =   1.2 
nstlist =   10 
DispCorr    =   no 
fourierspacing  =   0.1 
    ; Output setting
nstxout =   200000
nstvout =   200000
nstfout =   200000
nstenergy   =   200000
nstlog  =   200000
nstxout-compressed  =   1000000
; Molecular dynamics simulation setting
pbc =   xyz 
periodic-molecules  =   yes 
gen-vel =   no 
gen-temp    =   300 
gen-seed    =   -1 
integrator  =   md 
nsteps   =   50000000
dt  =   0.001
continuation    =   no 
comm-mode   =   Linear 
    ; Temperature
tcoupl  =   v-rescale 
tc-grps 	=	 Membrane Water_and_ions 
tau-t   =   0.1 0.1 
ref-t   =   300 300
nsttcouple  =   1 
nh-chain-length =   1 
    ; Pressure
pcoupl  =   Berendsen 
pcoupltype  =   isotropic
tau-p   =   10 
ref-p   =   1 
compressibility =   4.5e-5 
refcoord-scaling    =   all 

