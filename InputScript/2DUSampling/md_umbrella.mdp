; Simulation description
title = Umbrella sampling for sepcific configuration 
; Environment setting
    ; System setting
    ; vdW setting
vdwtype = cutoff 
cutoff-scheme = Verlet 
vdw-modifier = force-switch 
rvdw = 1.2 
rvdw-switch = 1.0 
    ; Coulomb setting 
coulombtype = PME 
pme-order = 4 
rcoulomb = 1.2 
    ; Bond setting 
constraints = h-bonds
constraint-algorithm = LINCS 
lincs-iter = 1
lincs-order = 4 
    ; Neighbor lisr setting 
rlist = 1.2 
nstlist = 10 
DispCorr = no 
fourierspacing = 0.1 
    ; Output setting 
nstxout = 100000
nstvout = 100000 
nstfout = 100000
nstenergy = 100000 
nstlog = 100000 
nstxout-compressed = 10000
; Molecular dynamics simulation setting
pbc = xyz 
periodic-molecules = yes 
gen-vel = no 
gen-temp = 300 
gen-seed = -1 
integrator = md 
nsteps = 80000000
dt = 0.001 
continuation = yes 
comm-mode = linear 
    ; Temperature
tcoupl = nose-hoover 
tc-grps = Membrane Water_and_ions 
tau-t = 0.1 0.1 
ref-t = 300 300 
nsttcouple = 1 
nh-chain-length = 1 
    ; Pressure
pcoupltype = isotropic 
pcoupl = Parrinello-rahman 
tau-p = 10 
ref-p = 1 
refcoord-scaling = all 
compressibility =   4.5e-5
