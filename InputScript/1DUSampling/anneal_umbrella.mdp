; Simulation description 
title   =   Annealing membrane to eliminate intrinsic stress
; Environment setting 

    ; System setting 
    ; vdW setting 
vdwtype =   cutoff 
cutoff-scheme   =   Verlet 
vdw-modifier    =   force-switch 
rvdw    =   1.2 
rvdw-switch =   1.0 
    ; Coulomb setting 
coulombtype =   PME 
pme-order   =   4
rcoulomb    =   1.2 
    ; Bond setting 
constraints =   h-bonds 
constraint-algorithm    =   LINCS 
lincs-iter  =   1 
lincs-order =   4 
fourierspacing  =   0.1 
    ; Neighbor list setting 
rlist   =   1.2 
nstlist =   10 
DispCorr    =   no 
    ; Output setting 
nstxout =   200000 
nstvout =   200000 
nstfout =   200000 
nstenergy   =   200000 
nstlog  =   200000
nstxout-compressed  =   1000000
; Molecular dynamics simulation setting 
pbc =   xyz 
periodic-molecules  =   yes 
gen-vel =   no 
gen-temp    =   300 
gen-seed    =   -1 
continuation    =   no 
integrator  =   md-vv 
nsteps  =   20000000 
dt  =   0.001 
comm-mode   =   linear 
    ; Temperature 
tcoupl  =   v-rescale 
tc-grps =   System 
tau-t   =   0.1 
ref-t   =   300 
    ; Pressure 
pcoupl  =   no 
    ; Annealing
annealing   =   periodic 
annealing-npoints   =   5 
annealing-time  =   0 500 1000 2000 2500 
annealing-temp  =   300 300 600 600 300 
    ; Pull 
pull    =   yes 
pull-nstxout    =   500 
pull-nstfout    =   500 
pull-ngroups    =   2 
pull-ncoords    =   1 
pull-group1-name    =   Membrane 
pull-group2-name 	=	 CA 
pull-group1-pbcatom =   -1 
pull-pbc-ref-prev-step-com  =   yes 
pull-coord1-type    =   umbrella 
pull-coord1-geometry    =   direction 
pull-coord1-groups  =   1 2 
pull-coord1-dim =   N N Y 
pull-coord1-start   =   no 
pull-coord1-vec =   0 0 1 
pull-coord1-init	=	XX 
pull-coord1-rate    =   0.0 
pull-coord1-k   =   500